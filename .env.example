# ─────────────────────────────────────────────────────────────────────────────
# APENAS a infraestrutura do Supabase vai em env. Credenciais de Meta/GA4 são
# gerenciadas PELO PAINEL (cifradas no banco), nunca aqui.
# Copie para .env.local e preencha. NUNCA comite .env* (veja .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Públicas (expostas ao browser) — apenas URL e anon key do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta — SÓ no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Enquanto as 3 variáveis acima estiverem VAZIAS, o sistema roda em MODO
# DEMONSTRAÇÃO: painel aberto sem login, com dados fictícios. Preencheu → o
# login volta e os dados passam a vir do banco.
# ─────────────────────────────────────────────────────────────────────────────

# Marca do painel (opcionais). Sem elas: "Seu Projeto" + iniciais desenhadas.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_LOGO=
